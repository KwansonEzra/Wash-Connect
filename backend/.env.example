NODE_ENV=development
PORT=5000

# The frontend origin allowed to make credentialed (cookie) requests in dev
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Connection String
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/washconnect?retryWrites=true&w=majority

# JWT Secret (generate a strong random string, e.g. `openssl rand -base64 32`)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# File Uploads
UPLOAD_DIR=./uploads

# Email (Nodemailer - use a Gmail App Password or a service like Mailtrap for dev)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
MAIL_FROM=noreply@washconnect.com

# Currency
DEFAULT_CURRENCY=NGN

# Used only by `npm run seed:admin` to bootstrap the first admin account
# (public registration can never create admin accounts - see README)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@washconnect.com
ADMIN_PASSWORD=change_this_before_seeding

