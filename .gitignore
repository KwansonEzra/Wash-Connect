# Dependencies
node_modules/
frontend/node_modules/
backend/node_modules/

# Environment variables (never commit real secrets)
.env
.env.local
.env.*.local
!.env.example

# Build output
frontend/dist/
frontend/dist-ssr/
backend/dist/

# Uploaded user files (keep the folder, ignore its contents)
backend/uploads/*
!backend/uploads/.gitkeep

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor/OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.local

# Test coverage
coverage/
